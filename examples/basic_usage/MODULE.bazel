module(name = "rules_libusb_basic_example")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_libusb")

# DO NOT copy this into your project. This allows this submodule to reference
# the main module
local_path_override(
    module_name = "rules_libusb",
    path = "../..",
)

libusb = use_extension("@rules_libusb//:extensions.bzl", "libusb")
libusb.source_release(
    min_version = "1.0.30",
    versions = {
        "1.0.30": "fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf",
    },
)
use_repo(libusb, "libusb")

# This is all just to vendor a Linux toolchain+sysroot for CI builds.
bazel_dep(name = "pigweed", version = "0.0.1", dev_dependency = True)
git_override(
    module_name = "pigweed",
    commit = "ee5b7a522470ee17187f3dc0a3f6e0ad619f6596",
    remote = "https://pigweed.googlesource.com/pigweed/pigweed.git",
)

register_toolchains(
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_linux",
    dev_dependency = True,
)
